    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.6.0"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "nodemon": "^3.0.1"
  }
}
