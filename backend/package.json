{
  "name": "dyslexia-platform-backend",
  "version": "1.0.0",
  "description": "Backend for dyslexia platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "npx kill-port 5000 && nodemon src/server.js",
    "dev:windows": "netstat -ano | findstr :5000 > nul && (for /f \"tokens=5\" %a in ('netstat -ano ^| findstr :5000 ^| findstr LISTENING') do taskkill /F /PID %a) || echo Port 5000 is free && nodemon src/server.js"
  },
